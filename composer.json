{
    "name": "communitales/log",
    "description": "Communitales Log Component",
    "keywords": [
        "log",
        "php"
    ],
    "type": "library",
    "homepage": "https://www.communitales.com",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^v3.95",
        "monolog/monolog": "^3.13",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.9",
        "sentry/sentry": "^4.38",
        "symfony/config": "^7.4 || ^8.1 || ^8.2",
        "symfony/dependency-injection": "^7.4 || ^8.1 || ^8.2",
        "symfony/process": "^7.4 || ^8.1 || ^8.2",
        "symfony/yaml": "^7.4 || ^8.1 || ^8.2"
    },
    "autoload": {
        "psr-4": {
            "Communitales\\Component\\Log\\": "src/Log"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Communitales\\Test\\Unit\\Component\\Log\\": "tests/Unit"
        }
    },
    "scripts": {
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon.dist",
        "rector": "vendor/bin/rector process",
        "test": "vendor/bin/phpunit",
        "codecheck": [
            "@rector",
            "@php-cs-fixer",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "bump-after-update": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
