{
    "name": "communitales/log",
    "description": "Communitales Log Component",
    "keywords": [
        "log",
        "php"
    ],
    "type": "library",
    "homepage": "https://www.communitales.com",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^v3.95",
        "monolog/monolog": "^3.11",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.3",
        "rector/rector": "^2.6",
        "sentry/sentry": "^4.31"
    },
    "suggest": {
        "sentry/sentry": "Enables automatic exception reporting to Sentry."
    },
    "autoload": {
        "psr-4": {
            "Communitales\\Component\\Log\\": "src/Log"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Communitales\\Test\\Unit\\Component\\Log\\": "tests/Unit"
        }
    },
    "scripts": {
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.dev.neon > docs/TODO-phpstan.md",
        "psalm": "vendor/bin/psalm -m > docs/TODO-psalm.md",
        "rector": "vendor/bin/rector process",
        "test": "vendor/bin/phpunit",
        "codecheck": [
            "@rector",
            "@php-cs-fixer",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
